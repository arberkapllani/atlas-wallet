# Atlas environment example
# Copy to `.env` (gitignored) and fill in values you need.

# Optional: third-party API keys for premium price/RPC providers.
# Atlas works without these — public endpoints are used by default.
# COINGECKO_API_KEY=
# ALCHEMY_API_KEY=
# INFURA_PROJECT_ID=

# Optional: MoonPay / on-ramp partner keys (configured at runtime via UI)
# MOONPAY_PUBLIC_KEY=
