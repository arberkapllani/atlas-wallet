{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard",
    ":separatePatchReleases"
  ],
  "timezone": "Europe/Tirane",
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "rust": {
    "enabled": true
  },
  "cargo": {
    "rangeStrategy": "bump"
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "Group all minor + patch updates",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "all non-major dependencies"
    },
    {
      "description": "Tauri / SvelteKit major updates need manual review",
      "matchPackageNames": ["tauri", "tauri-build", "@sveltejs/kit", "svelte"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Crypto crates: never auto-merge majors",
      "matchPackageNames": [
        "bitcoin",
        "secp256k1",
        "bip39",
        "ed25519-dalek",
        "aes-gcm",
        "argon2"
      ],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "prHourlyLimit": 4,
  "prConcurrentLimit": 10
}
